{
  "name": "lasmex-desktop",
  "productName": "LasmeX",
  "description": "LasmeX desktop application with an embedded Host and a sandboxed local renderer",
  "version": "0.1.0",
  "private": true,
  "author": "LasmeX contributors",
  "license": "MIT",
  "type": "module",
  "main": "lib/main.js",
  "files": [
    "assets",
    "desktop.patch.yml",
    "lib",
    "renderer"
  ],
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsc -b tsconfig.host.json && tsdown",
    "build:renderer": "tsc -b tsconfig.client.json && vite build",
    "start": "pnpm -w run build:lib && pnpm run build && electron .",
    "package": "pnpm -w run build:lib && pnpm run build && node scripts/distribute.mjs package",
    "make": "pnpm -w run build:lib && pnpm run build && node scripts/distribute.mjs make",
    "make:windows": "pnpm -w run build:lib && pnpm run build && node scripts/distribute.mjs make win32",
    "make:macos": "pnpm -w run build:lib && pnpm run build && node scripts/distribute.mjs make darwin",
    "make:linux": "pnpm -w run build:lib && pnpm run build && node scripts/distribute.mjs make linux",
    "smoke:artifact": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-windows.ps1",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
    "@deepseek-ai/cosmokit": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "lasmex": "workspace:^",
    "lasmex-anonymous-user-id": "workspace:^",
    "lasmex-app-boot": "workspace:^",
    "lasmex-atomic-write": "workspace:^",
    "lasmex-bash-local": "workspace:^",
    "lasmex-client-connection": "workspace:^",
    "lasmex-client-modules": "workspace:^",
    "lasmex-client-ui-directory-picker-native": "workspace:^",
    "lasmex-client-web": "workspace:^",
    "lasmex-code-runtime": "workspace:^",
    "lasmex-compaction": "workspace:^",
    "lasmex-fs": "workspace:^",
    "lasmex-host-directory-picker-native": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-output-retention": "workspace:^",
    "lasmex-sandbox": "workspace:^",
    "lasmex-scope": "workspace:^",
    "lasmex-session-telemetry": "workspace:^",
    "lasmex-session-title-llm": "workspace:^",
    "lasmex-shell": "workspace:^",
    "lasmex-spill": "workspace:^",
    "lasmex-subagent-in-process-driver": "workspace:^",
    "lasmex-subprocess": "workspace:^",
    "lasmex-timeout": "workspace:^",
    "lasmex-workflow": "workspace:^",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron/asar": "3.4.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.20.0",
    "electron": "43.4.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
