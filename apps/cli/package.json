{
  "name": "lasmex",
  "description": "LasmeX CLI: profile boot, plugin management, and browser UI",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "lasmex": "lib/bin.js"
  },
  "exports": {
    "./identity": {
      "types": "./lib/types/identity.d.ts",
      "default": "./lib/identity.js"
    },
    "./profile-boot": {
      "types": "./lib/types/profile-boot.d.ts",
      "default": "./lib/profile-boot.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/*.d.ts",
    "config"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis-plugin-hmr": "workspace:^",
