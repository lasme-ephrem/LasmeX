{
  "name": "lasmex-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "lasmex-attachment": "workspace:^",
    "lasmex-agent": "workspace:^",
    "lasmex-agent-default-model": "workspace:^",
    "lasmex-api-remotes": "workspace:^",
    "lasmex-brand": "workspace:^",
    "lasmex-commands": "workspace:^",
    "lasmex-credentials": "workspace:^",
    "lasmex-goal": "workspace:^",
    "lasmex-host-directory-picker": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-native-command": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-session-persistence": "workspace:^",
    "lasmex-session-projection": "workspace:^",
    "lasmex-session-projection-cache": "workspace:^",
    "lasmex-session-query": "workspace:^",
    "lasmex-session-title": "workspace:^",
    "lasmex-settings": "workspace:^",
    "lasmex-skill": "workspace:^",
    "lasmex-subagent": "workspace:^",
    "lasmex-jobs": "workspace:^",
    "lasmex-tools": "workspace:^",
    "lasmex-user-approval": "workspace:^",
    "lasmex-user-questions": "workspace:^",
    "lasmex-workspace": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "lasmex-agent-presets": "workspace:^",
    "lasmex-cordis-host-runner": "workspace:^",
    "lasmex-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "lasmex-agent-presets": "workspace:^",
    "lasmex-cordis-host-runner": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-storage": "workspace:^",
    "lasmex-storage-domain": "workspace:^",
    "lasmex-typert-protocol": "workspace:^",
    "lasmex-typert-registry": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/host/apiproxy"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
