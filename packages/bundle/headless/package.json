{
  "name": "lasmex-headless",
  "description": "The dsh one-shot bundle: a direct core Agent/Session runner over lasmex-base with no Host, HTTP, or browser layer",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "lasmex": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "lasmex-cmdline": "workspace:^",
    "lasmex-code-runtime-worker-thread": "workspace:^",
    "lasmex-tool-memory": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "lasmex-agent": "workspace:^",
    "lasmex-agent-default-model": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-session": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "lasmex-agent": "workspace:^",
    "lasmex-agent-default-model": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-session": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/bundle/headless"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
