{
  "name": "lasmex-llm-deepseek",
  "description": "DeepSeek chat-completions adapter for LasmeX LLM seam",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "lasmex-credentials": "workspace:^",
    "lasmex-launch-environment": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-settings": "workspace:^",
    "lasmex-timeout": "workspace:^",
    "lasmex-anonymous-user-id": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "eventsource-parser": "^3.1.0",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "lasmex-credentials": "workspace:^",
    "lasmex-launch-environment": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-settings": "workspace:^",
    "lasmex-timeout": "workspace:^",
    "lasmex-anonymous-user-id": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/llm/llm-deepseek"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
