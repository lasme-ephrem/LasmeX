{
  "name": "lasmex-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process LasmeX SDK clients",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "lasmex-agent": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-llm-deepseek": "workspace:^",
    "lasmex-scope": "workspace:^",
    "lasmex-sdk-protocol": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-subagent": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "lasmex-agent": "workspace:^",
    "lasmex-agent-spine-demo": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-llm-deepseek": "workspace:^",
    "lasmex-scope": "workspace:^",
    "lasmex-sdk-protocol": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-session-persistence-jsonl": "workspace:^",
    "lasmex-subagent": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/sdk/server"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
