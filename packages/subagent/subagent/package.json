{
  "name": "lasmex-subagent",
  "description": "Abstract subagent seam (ctx.subagents): named-provider registry for delegating to child agents",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "lasmex-agent": "workspace:^",
    "lasmex-agent-presets": "workspace:^",
    "lasmex-brand": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-sandbox": "workspace:^",
    "lasmex-sandbox-policy": "workspace:^",
    "lasmex-scope": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-session-persistence": "workspace:^",
    "lasmex-session-projection": "workspace:^",
    "lasmex-session-projection-cache": "workspace:^",
    "lasmex-jobs": "workspace:^",
    "lasmex-tools": "workspace:^",
    "lasmex-user-approval": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "lasmex-agent-presets": {
      "optional": true
    },
    "lasmex-sandbox": {
      "optional": true
    },
    "lasmex-sandbox-policy": {
      "optional": true
    },
    "lasmex-session-persistence": {
      "optional": true
    },
    "lasmex-session-projection": {
      "optional": true
    },
    "lasmex-session-projection-cache": {
      "optional": true
    },
    "lasmex-jobs": {
      "optional": true
    },
    "lasmex-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "lasmex-agent": "workspace:^",
    "lasmex-agent-presets": "workspace:^",
    "lasmex-brand": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-sandbox": "workspace:^",
    "lasmex-sandbox-policy": "workspace:^",
    "lasmex-scope": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-session-persistence": "workspace:^",
    "lasmex-session-projection": "workspace:^",
    "lasmex-session-projection-cache": "workspace:^",
    "lasmex-storage": "workspace:^",
    "lasmex-storage-domain": "workspace:^",
    "lasmex-jobs": "workspace:^",
    "lasmex-tools": "workspace:^",
    "lasmex-user-approval": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/subagent/subagent"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
