{
  "name": "lasmex-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "lasmex-agent": "workspace:^",
    "lasmex-shell": "workspace:^",
    "lasmex-shell-env": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-sandbox": "workspace:^",
    "lasmex-sandbox-policy": "workspace:^",
    "lasmex-system-prompt": "workspace:^",
    "lasmex-jobs": "workspace:^",
    "lasmex-tools": "workspace:^",
    "lasmex-user-approval": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "lasmex-agent": "workspace:^",
    "lasmex-agent-loop": "workspace:^",
    "lasmex-agent-loop-testkit": "workspace:^",
    "lasmex-shell": "workspace:^",
    "lasmex-shell-env": "workspace:^",
    "lasmex-bash-local": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-subprocess-local": "workspace:^",
    "lasmex-sandbox": "workspace:^",
    "lasmex-sandbox-policy": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-session-persistence-jsonl": "workspace:^",
    "lasmex-system-prompt": "workspace:^",
    "lasmex-jobs": "workspace:^",
    "lasmex-jobs-local": "workspace:^",
    "lasmex-tool-jobs": "workspace:^",
    "lasmex-tools": "workspace:^",
    "lasmex-user-approval": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/shell/tool-bash"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
