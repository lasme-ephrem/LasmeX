{
  "name": "lasmex-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-output-retention": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-spill": "workspace:^",
    "lasmex-subprocess": "workspace:^",
    "lasmex-system-prompt": "workspace:^",
    "lasmex-timeout": "workspace:^",
    "lasmex-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "lasmex-agent": "workspace:^",
    "lasmex-subprocess": "workspace:^",
    "lasmex-subprocess-local": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-output-retention": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-spill": "workspace:^",
    "lasmex-system-prompt": "workspace:^",
    "lasmex-timeout": "workspace:^",
    "lasmex-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
