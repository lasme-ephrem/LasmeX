{
  "name": "lasmex-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over LasmeX filesystem seam (ctx.fs)",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "lasmex-attachment": "workspace:^",
    "lasmex-fs": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-sandbox": "workspace:^",
    "lasmex-sandbox-policy": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-system-prompt": "workspace:^",
    "lasmex-tools": "workspace:^",
    "lasmex-user-approval": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "lasmex-agent": "workspace:^",
    "lasmex-agent-loop": "workspace:^",
    "lasmex-agent-loop-testkit": "workspace:^",
    "lasmex-attachment": "workspace:^",
    "lasmex-fs": "workspace:^",
    "lasmex-fs-local": "workspace:^",
    "lasmex-fs-observation-policy": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-llm-deepseek": "workspace:^",
    "lasmex-sandbox": "workspace:^",
    "lasmex-sandbox-policy": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-system-prompt": "workspace:^",
    "lasmex-tools": "workspace:^",
    "lasmex-user-approval": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/fs/tool-fs"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
