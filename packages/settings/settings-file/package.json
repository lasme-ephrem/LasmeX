{
  "name": "lasmex-settings-file",
  "description": "File-backed settings provider (settings.yaml) for LasmeX",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "lasmex-atomic-write": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-home-paths": "workspace:^",
    "lasmex-settings": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "@deepseek-ai/schemastery": "workspace:^",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "lasmex-atomic-write": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-home-paths": "workspace:^",
    "lasmex-settings": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/settings/settings-file"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
