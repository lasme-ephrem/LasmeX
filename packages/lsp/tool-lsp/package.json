{
  "name": "lasmex-tool-lsp",
  "description": "Model-facing lsp tool over LasmeX LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-lsp": "workspace:^",
    "lasmex-system-prompt": "workspace:^",
    "lasmex-timeout": "workspace:^",
    "lasmex-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "lasmex-agent": "workspace:^",
    "lasmex-fs-local": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-lsp": "workspace:^",
    "lasmex-lsp-stdio": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-subprocess-local": "workspace:^",
    "lasmex-system-prompt": "workspace:^",
    "lasmex-timeout": "workspace:^",
    "lasmex-tool-call-timeout-policy": "workspace:^",
    "lasmex-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
