{
  "name": "lasmex-subprocess-local",
  "description": "Local-subprocess implementation of LasmeX subprocess seam",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "scripts/ensure-spawn-helper.mjs",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-spawn-helper.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "lasmex-invariants": "workspace:^",
    "lasmex-subprocess": "workspace:^",
    "lasmex-timeout": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "lasmex-invariants": "workspace:^",
    "lasmex-loader-smoke": "workspace:^",
    "lasmex-subprocess": "workspace:^",
    "lasmex-timeout": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/subprocess/subprocess-local"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
