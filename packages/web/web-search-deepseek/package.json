{
  "name": "lasmex-web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for LasmeX web capability seam (ctx.web)",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "lasmex-agent": "workspace:^",
    "lasmex-credentials": "workspace:^",
    "lasmex-launch-environment": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-web": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "lasmex-settings": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "lasmex-agent": "workspace:^",
    "lasmex-credentials": "workspace:^",
    "lasmex-credentials-local": "workspace:^",
    "lasmex-launch-environment": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-web": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "lasmex-settings": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
