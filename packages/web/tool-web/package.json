{
  "name": "lasmex-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over LasmeX web capability seam (ctx.web)",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-system-prompt": "workspace:^",
    "lasmex-tools": "workspace:^",
    "lasmex-web": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@deepseek-ai/schemastery": "workspace:^",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "lasmex-agent": "workspace:^",
    "@types/turndown": "^5.0.6",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-spill-local": "workspace:^",
    "lasmex-spill-policy": "workspace:^",
    "lasmex-system-prompt": "workspace:^",
    "lasmex-tool-call-timeout-policy": "workspace:^",
    "lasmex-tools": "workspace:^",
    "lasmex-web": "workspace:^",
    "lasmex-web-fetch-http": "workspace:^",
    "lasmex-web-search-exa": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/web/tool-web"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
