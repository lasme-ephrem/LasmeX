{
  "name": "lasmex-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for LasmeX",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "lasmex-agent": "workspace:^",
    "lasmex-atomic-write": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-home-paths": "workspace:^",
    "lasmex-scope": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-settings": "workspace:^",
    "lasmex-system-prompt": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "lasmex-agent": "workspace:^",
    "lasmex-agent-loop": "workspace:^",
    "lasmex-atomic-write": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-home-paths": "workspace:^",
    "lasmex-scope": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-settings": "workspace:^",
    "lasmex-settings-file": "workspace:^",
    "lasmex-system-prompt": "workspace:^",
    "lasmex-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/preset/agent-presets"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
