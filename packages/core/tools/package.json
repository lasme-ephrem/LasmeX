{
  "name": "lasmex-tools",
  "description": "Tool registry and execution pipeline for LasmeX",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./presentation": {
      "types": "./lib/types/presentation.d.ts",
      "default": "./lib/types/presentation.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "lasmex-agent": "workspace:^",
    "lasmex-code-runtime": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-scope": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-system-prompt": "workspace:^",
    "lasmex-user-approval": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "lasmex-agent": "workspace:^",
    "lasmex-code-runtime": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-scope": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-system-prompt": "workspace:^",
    "lasmex-user-approval": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/core/tools"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
