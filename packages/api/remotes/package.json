{
  "name": "lasmex-api-remotes",
  "description": "Remote BFF assembly and Host Agent/Session lookup policy",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "lasmex": {
    "client": {
      "inject": [
        "lasmex-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "lasmex-typert-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "lasmex-agent": "workspace:^",
    "lasmex-api-gateway": "workspace:^",
    "lasmex-commands": "workspace:^",
    "lasmex-credentials": "workspace:^",
    "lasmex-goal": "workspace:^",
    "lasmex-cordis-host-runner": "workspace:^",
    "lasmex-host-plugin-inventory": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-agent-presets": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-message-feedback": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-session-persistence": "workspace:^",
    "lasmex-settings": "workspace:^",
    "lasmex-typert-registry": "workspace:^"
  },
  "devDependencies": {
    "lasmex-agent": "workspace:^",
    "lasmex-api-gateway": "workspace:^",
    "lasmex-commands": "workspace:^",
    "lasmex-credentials": "workspace:^",
    "lasmex-goal": "workspace:^",
    "lasmex-cordis-host-runner": "workspace:^",
    "lasmex-host-plugin-inventory": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-agent-presets": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-message-feedback": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-session-persistence": "workspace:^",
    "lasmex-settings": "workspace:^",
    "lasmex-typert-registry": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/api/remotes"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
