{
  "name": "lasmex-client-ui-conversation",
  "description": "Conversation domain: skeleton, ordered chat flow, composer with the Host-backed busy-Enter preference, and details host",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "lasmex": {
    "client": {
      "inject": [
        "lasmex-client-connection",
        "lasmex-client-locale",
        "lasmex-client-runtime",
        "lasmex-client-ui-settings",
        "lasmex-api-remotes",
        "lasmex-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "lasmex-settings": "workspace:^",
    "clsx": "^2.0.0",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "lasmex-agent": "workspace:^",
    "lasmex-api-remotes": "workspace:^",
    "lasmex-attachment": "workspace:^",
    "lasmex-brand": "workspace:^",
    "lasmex-client-connection": "workspace:^",
    "lasmex-client-locale": "workspace:^",
    "lasmex-client-runtime": "workspace:^",
    "lasmex-client-ui-attachment": "workspace:^",
    "lasmex-client-ui-primitives": "workspace:^",
    "lasmex-client-ui-settings": "workspace:^",
    "lasmex-client-ui-input-trigger": "workspace:^",
    "lasmex-client-ui-slots": "workspace:^",
    "lasmex-commands": "workspace:^",
    "lasmex-compaction": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm-retry": "workspace:^",
    "lasmex-session-stats": "workspace:^",
    "lasmex-token-meter": "workspace:^",
    "lasmex-tools": "workspace:^",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "lasmex-agent": "workspace:^",
    "lasmex-api-remotes": "workspace:^",
    "lasmex-attachment": "workspace:^",
    "lasmex-brand": "workspace:^",
    "lasmex-client-connection": "workspace:^",
    "lasmex-client-locale": "workspace:^",
    "lasmex-client-runtime": "workspace:^",
    "lasmex-client-test-runtime": "workspace:^",
    "lasmex-client-ui-layout": "workspace:^",
    "lasmex-client-ui-attachment": "workspace:^",
    "lasmex-client-ui-primitives": "workspace:^",
    "lasmex-client-ui-settings": "workspace:^",
    "lasmex-client-ui-input-trigger": "workspace:^",
    "lasmex-client-ui-slots": "workspace:^",
    "lasmex-commands": "workspace:^",
    "lasmex-compaction": "workspace:^",
    "lasmex-goal": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-llm-retry": "workspace:^",
    "lasmex-permission-presets": "workspace:^",
    "lasmex-plan-mode": "workspace:^",
    "lasmex-session-projection": "workspace:^",
    "lasmex-session-stats": "workspace:^",
    "lasmex-token-meter": "workspace:^",
    "lasmex-tool-todo": "workspace:^",
    "lasmex-tools": "workspace:^",
