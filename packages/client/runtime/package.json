{
  "name": "lasmex-client-runtime",
  "description": "Client core services: SlotRegistry, SessionRuntime (scope tree + object layer)",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "lasmex": {
    "client": {
      "inject": [
        "lasmex-client-connection",
        "lasmex-typert-registry",
        "lasmex-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "lasmex-agent": "workspace:^",
    "lasmex-attachment": "workspace:^",
    "lasmex-client-connection": "workspace:^",
    "lasmex-commands": "workspace:^",
    "lasmex-client-ui-slots": "workspace:^",
    "lasmex-host-apiproxy": "workspace:^",
    "lasmex-llm": "workspace:^",
    "lasmex-llm-retry": "workspace:^",
    "lasmex-session": "workspace:^",
    "lasmex-session-projection": "workspace:^",
    "lasmex-session-title": "workspace:^",
    "lasmex-tools": "workspace:^",
    "immer": "^10.1.1",
    "react": "^18.2.0",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "lasmex-api-remotes": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-typert-protocol": "workspace:^",
    "lasmex-typert-registry": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "lasmex-api-remotes": "workspace:^",
    "lasmex-invariants": "workspace:^",
    "lasmex-timeout": "workspace:^",
    "lasmex-typert-protocol": "workspace:^",
    "lasmex-typert-registry": "workspace:^",
    "@types/react": "~18.3.1"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lasme-ephrem/LasmeX.git",
    "directory": "packages/client/runtime"
  },
  "homepage": "https://github.com/lasme-ephrem/LasmeX#readme",
  "bugs": {
    "url": "https://github.com/lasme-ephrem/LasmeX/issues"
  }
}
